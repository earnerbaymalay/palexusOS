# PalexusOS Distribution & Build Gitignore
# Strict protection against ISO artifacts, chroots, build caches, and credentials

# ISO Builds & Working Root Filesystems
build/work/
build/out/
out/
*.iso
*.iso.sig
*.iso.sha256
# Generated overlay staging only; keep the archiso customize hook tracked
/build/archiso/airootfs/etc/
/build/archiso/airootfs/var/
/build/archiso/airootfs/usr/
root.x86_64/

# Package Builds & Arch PKGBUILD Caches
*.pkg.tar.zst
*.pkg.tar.xz
*.pkg.tar.gz
src/
pkg/

# Compiled Binaries & Rust Cargo
target/
Cargo.lock
*.so
*.o
*.a

# Node / Web UI Caches
node_modules/
dist/
.pnpm-store/
npm-debug.log*

# Python & Local AI Virtualenvs
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.perf/

# Credentials, Keys & Local Secrets
*.pem
*.key
*.crt
*.p12
*.secret
*id_rsa*
*id_ed25519*
.env
.env.*
!.env.example

# Temporary & Editor Artifacts
.DS_Store
*.swp
*.swo
*~
.idea/
*.log

# Claude CLI caches and local settings (shared hooks are tracked so cloud sessions get them)
.claude/*
!.claude/settings.json
!.claude/mattflow/

# Blender binary files, renders, and intermediate video assets
build/blender/*.blend*
build/blender/renders/
docs/assets/videos/

# makepkg git source clone
packages/core/palexus-core/synapse/
packages/desktop/llm-quickfire-panel/llm-quickfire-panel/

build/blender/*.mp4

# tools/wave-pipeline.sh sprint artifacts
build/sprints/

# Boost shell-output cache (local tooling)
.boost/

# Python packaging (root-level setuptools output only; build/ itself holds the archiso profile)
/build/lib/
/build/bdist.*/
dist/
*.egg-info/
*.whl
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
