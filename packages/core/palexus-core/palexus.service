[Unit]
Description=Palexus AI Core Runtime Gateway & Context Firewall
Documentation=https://github.com/earnerbaymalay/palexus
# Localhost-only gateway in front of local ollama: no network-online dependency
After=ollama.service

[Service]
Type=simple
# `serve` takes CLI flags only (no --config); clap exits 2 on unknown arguments
ExecStart=/usr/bin/palexus serve --host 127.0.0.1 --port 8000
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
DynamicUser=yes
User=palexus-daemon
Group=palexus-daemon
StateDirectory=palexus
ConfigurationDirectory=palexus
RuntimeDirectory=palexus

# Security & Sandbox Hardening (Prime Directive)
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

# Environment
Environment="RUST_LOG=info,palexus=info"

[Install]
WantedBy=multi-user.target
