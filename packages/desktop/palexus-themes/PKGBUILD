# Maintainer: PalexusOS Engineering Team <maintainers@palexusos.org>
pkgname=palexus-themes
pkgver=0.1.0
pkgrel=5
pkgdesc="PalexusOS wallpapers (3 designs x accent variants), system theme switcher (Super+Ctrl+T) and geodesic torus screensaver"
arch=('any')
url="https://github.com/earnerbaymalay/synapseOS"
license=('MIT')
provides=('synapse-themes' 'palexus-themes')
conflicts=('synapse-themes')
depends=('bash' 'python' 'rofi' 'kitty' 'xfconf' 'xorg-xrandr' 'xprintidle' 'swaybg' 'libnotify')
optdepends=(
  'python-terminaltexteffects: tte effects for the screensaver brand reveal (AUR)'
  'foot: Wayland fallback terminal for the screensaver'
)
source=(
  'palexus-theme'
  'palexus-screensaver'
  'palexus-idle'
  'palexus-theme-restore.desktop'
  'palexus-idle.desktop'
  'palexus-screensaver.desktop'
  'palexus-carbon-crimson.jpg'
  'palexus-carbon-emerald.jpg'
  'palexus-carbon-mauve.jpg'
  'palexus-carbon-sapphire.jpg'
  'palexus-carbon-tungsten.jpg'
  'palexus-monolith-emerald.jpg'
  'palexus-monolith-mauve.jpg'
  'palexus-monolith-sapphire.jpg'
  'palexus-monolith-tungsten.jpg'
  'palexus-tower-crimson.jpg'
  'palexus-tower-emerald.jpg'
  'palexus-tower-mauve.jpg'
  'palexus-tower-sapphire.jpg'
  'palexus-tower-tungsten.jpg'
)
