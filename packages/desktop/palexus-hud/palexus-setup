#!/usr/bin/env bash
# ==============================================================================
# palexus-setup — PalexusOS Local AI & Neural Model Orchestrator
# Maintainer: earnerbaymalay
# FOSS | Zero-Telemetry | Autonomous LLM Orchestration
# ==============================================================================
set -eo pipefail

STATE_DIR="${HOME}/.config/palexus"
FIRSTBOOT_FLAG="${STATE_DIR}/.firstboot_complete"
OLLAMA_API="http://127.0.0.1:11434"

# Targeted core models for PalexusOS
PRIMARY_CODE_MODEL="qwen2.5-coder:1.5b"
PRIMARY_CHAT_MODEL="llama3.2:latest"
PRIMARY_EMBED_MODEL="nomic-embed-text:latest"

# Fallback code model for systems with >12GB RAM
HEAVY_CODE_MODEL="qwen2.5-coder:latest"

show_help() {
    cat << 'EOF'
palexus-setup — PalexusOS Local AI & Neural Model Manager

Usage:
  palexus-setup [OPTIONS]

Core Operations:
  --first-boot        Run non-blocking first-boot setup (pulls code, chat & embed models)
  --status            Display local AI engine, active models, memory & stealth status
  --pull-core         Download the core model trinity (Code + Chat + Embeddings)
  --pull-model [NAME] Download and verify any Ollama or Hugging Face model
  --pull-hf [REPO]    Download a Hugging Face GGUF model (e.g. hf.co/bartowski/Qwen2.5-7B)
  --interactive, -i   Launch interactive model selection menu
  --serve             Ensure Ollama daemon is running and reachable
  --warm              Pre-warm resident models in RAM for instant inference
  --flush             Flush resident models from RAM
  --reset-firstboot   Reset first-boot marker to allow re-running initialization
  --help, -h          Show this help message

Targeted System Models:
  • Terminal Code & Shell:   qwen2.5-coder (1.5b / 7b)
  • Conversation & Search:   llama3.2 (3b) / qwen2.5 (7b)
  • 3-Layer Agent Memory:    nomic-embed-text (embeddings)
  • Reasoning / Chain-of-Thought: deepseek-r1 / phi4
  • Hugging Face GGUFs:      Native support via hf.co/<user>/<repo>
EOF
}

is_online() {
    if command -v nc >/dev/null 2>&1; then
        nc -z -w 3 9.9.9.9 53 >/dev/null 2>&1 && return 0
    fi
    ping -c 1 -W 3 9.9.9.9 >/dev/null 2>&1 && return 0
    return 1
}

notify() {
    local title="$1"
    local message="$2"
    local icon="${3:-dialog-information}"
    if command -v notify-send >/dev/null 2>&1 && [[ -n "${DISPLAY:-${WAYLAND_DISPLAY:-}}" ]]; then
        notify-send -a "Palexus AI" -i "${icon}" "${title}" "${message}" 2>/dev/null || true
    fi
}

check_ollama() {
    curl -s --connect-timeout 2 "${OLLAMA_API}/api/tags" >/dev/null 2>&1
}

find_ollama_cmd() {
    if command -v ollama >/dev/null 2>&1; then
        echo "ollama"
    elif [[ -x "${HOME}/.local/bin/ollama" ]]; then
        echo "${HOME}/.local/bin/ollama"
    elif [[ -x "/usr/bin/ollama" ]]; then
        echo "/usr/bin/ollama"
    else
        echo "ollama"
    fi
}

ensure_ollama_running() {
    if check_ollama; then
        return 0
    fi

    # Try systemd service first
    systemctl --user start ollama 2>/dev/null || sudo systemctl start ollama 2>/dev/null || true
    for _ in {1..5}; do
        if check_ollama; then
            return 0
        fi
        sleep 1
    done

    # If systemd did not start it, launch standalone daemon in background
    local ollama_bin
    ollama_bin="$(find_ollama_cmd)"
    if command -v "$ollama_bin" >/dev/null 2>&1 || [[ -x "$ollama_bin" ]]; then
        nohup "$ollama_bin" serve >/dev/null 2>&1 &
        for _ in {1..8}; do
            if check_ollama; then
                return 0
            fi
            sleep 1
        done
    fi

    return 1
}

model_exists() {
    local target="$1"
    local base="${target%%:*}"
    curl -s "${OLLAMA_API}/api/tags" 2>/dev/null | grep -q "\"name\":\"[^\"]*${base}"
}

pull_single_model() {
    local model="$1"
    local ollama_bin
    ollama_bin="$(find_ollama_cmd)"

    echo "==> Pulling model: ${model}..."
    if command -v ionice >/dev/null 2>&1; then
        nice -n 19 ionice -c 3 "$ollama_bin" pull "${model}" || "$ollama_bin" pull "${model}"
    else
        nice -n 19 "$ollama_bin" pull "${model}" || "$ollama_bin" pull "${model}"
    fi
}

pull_core_models() {
    ensure_ollama_running || {
        echo "[ERROR] Ollama daemon could not be reached at ${OLLAMA_API}" >&2
        return 1
    }

    echo "=============================================================================="
    echo " PalexusOS — Provisioning Targeted System AI Models"
    echo "=============================================================================="

    # 1. Memory Embeddings Model (Required for Palexus Memory)
    if ! model_exists "${PRIMARY_EMBED_MODEL}"; then
        echo "--> [1/3] Downloading Palexus Memory Embeddings (${PRIMARY_EMBED_MODEL})..."
        pull_single_model "${PRIMARY_EMBED_MODEL}"
    else
        echo "--> [1/3] Embeddings model already installed: ${PRIMARY_EMBED_MODEL} ✔"
    fi

    # 2. Terminal Code Execution Model
    if ! model_exists "qwen2.5-coder"; then
        echo "--> [2/3] Downloading Code & Terminal Execution Model (${PRIMARY_CODE_MODEL})..."
        pull_single_model "${PRIMARY_CODE_MODEL}"
    else
        echo "--> [2/3] Code model already installed: qwen2.5-coder ✔"
    fi

    # 3. General Conversation & Instruction Following Model
    if ! model_exists "llama3.2" && ! model_exists "qwen2.5"; then
        echo "--> [3/3] Downloading General Conversation & Search Model (${PRIMARY_CHAT_MODEL})..."
        pull_single_model "${PRIMARY_CHAT_MODEL}"
    else
        echo "--> [3/3] Chat/Instruction model already installed ✔"
    fi

    # Pre-warm code model
    warm_models
    echo "=============================================================================="
    echo " All targeted core models are provisioned and operational."
    echo "=============================================================================="
}

warm_models() {
    if check_ollama; then
        echo "==> Pre-warming model cache in memory..."
        local active_code="${PRIMARY_CODE_MODEL}"
        if model_exists "qwen2.5-coder:latest"; then
            active_code="qwen2.5-coder:latest"
        elif model_exists "qwen2.5-coder:1.5b"; then
            active_code="qwen2.5-coder:1.5b"
        fi
        curl -s -X POST "${OLLAMA_API}/api/generate" -d "{\"model\": \"${active_code}\", \"prompt\": \"Ready\"}" >/dev/null 2>&1 &
        echo "==> Pre-warmed: ${active_code}"
    fi
}

flush_models() {
    local ollama_bin
    ollama_bin="$(find_ollama_cmd)"
    if check_ollama; then
        local running
        running=$("$ollama_bin" ps 2>/dev/null | awk 'NR>1 {print $1}')
        if [[ -n "$running" ]]; then
            echo "Unloading resident models from RAM: $running"
            for m in $running; do
                "$ollama_bin" stop "$m" >/dev/null 2>&1 || true
            done
            notify "Palexus AI" "Resident models flushed from memory" "dialog-information"
        else
            echo "No resident models currently loaded in RAM."
        fi
    fi
}

run_first_boot() {
    mkdir -p "${STATE_DIR}"
    if [[ -f "${FIRSTBOOT_FLAG}" ]]; then
        exit 0
    fi

    sleep 4

    if ! is_online; then
        exit 0
    fi

    if ! ensure_ollama_running; then
        exit 0
    fi

    notify "Palexus AI Setup" "Provisioning local AI core models in background..." "system-software-update"
    pull_core_models >/dev/null 2>&1 || true

    notify "Palexus AI Ready" "Local AI & Memory models are initialized and operational." "dialog-information"
    touch "${FIRSTBOOT_FLAG}"
}

interactive_menu() {
    local ollama_bin
    ollama_bin="$(find_ollama_cmd)"
    ensure_ollama_running

    while true; do
        clear
        cat << 'EOF'
 🧠 SYNAPSEOS — LOCAL AI & MODEL PROVISIONING CONSOLE
══════════════════════════════════════════════════════════════════════════════
 1) [Core Trinity] Install Code (Qwen), Chat (LLaMA 3.2), and Memory (Nomic)
 2) [Coding Focus] Install Flagship Qwen 2.5 Coder 7B (Requires 8GB+ RAM)
 3) [Reasoning]    Install DeepSeek-R1 Distill (CoT Reasoning)
 4) [Reasoning]    Install Microsoft Phi-4 (High reasoning, 14B compact)
 5) [Uncensored]   Install Dolphin Mistral (Raw assistance & security testing)
 6) [Hugging Face] Pull any custom GGUF model via hf.co/<user>/<repo>
 7) [Custom Ollama] Pull any model by name from Ollama library
 8) [Status]       View installed models and system memory footprint
 9) [Flush]        Unload resident models from RAM
 0) Exit
══════════════════════════════════════════════════════════════════════════════
EOF
        read -r -p " Select option [0-9]: " choice
        echo ""

        case "$choice" in
            1)
                pull_core_models
                ;;
            2)
                pull_single_model "qwen2.5-coder:latest"
                ;;
            3)
                pull_single_model "deepseek-r1:latest"
                ;;
            4)
                pull_single_model "phi4:latest"
                ;;
            5)
                pull_single_model "dolphin-mistral:latest"
                ;;
            6)
                read -r -p "Enter Hugging Face GGUF repository (e.g. hf.co/bartowski/Qwen2.5-7B-Instruct-GGUF): " hf_model
                if [[ -n "$hf_model" ]]; then
                    pull_single_model "$hf_model"
                fi
                ;;
            7)
                read -r -p "Enter Ollama model name (e.g. mistral, codellama, starcoder2): " custom_model
                if [[ -n "$custom_model" ]]; then
                    pull_single_model "$custom_model"
                fi
                ;;
            8)
                show_status
                ;;
            9)
                flush_models
                ;;
            0|q|Q)
                break
                ;;
            *)
                echo "Invalid selection."
                ;;
        esac
        echo ""
        read -r -p "Press Enter to continue..."
    done
}

show_status() {
    local ollama_bin
    ollama_bin="$(find_ollama_cmd)"

    echo "=============================================================================="
    echo " PalexusOS System & Local AI Architecture Status"
    echo "=============================================================================="
    
    # 1. Ollama Daemon
    if check_ollama; then
        echo "  [AI Daemon]      Ollama is RUNNING (http://127.0.0.1:11434) ✔"
        echo ""
        echo "  [Installed Models]:"
        local list_output
        list_output=$("$ollama_bin" list 2>/dev/null | tail -n +2)
        if [[ -n "$list_output" ]]; then
            echo "$list_output" | while read -r name id size rest; do
                local tag="General"
                if [[ "$name" == *"coder"* ]]; then
                    tag="💻 Code Execution"
                elif [[ "$name" == *"embed"* ]]; then
                    tag="🧬 Memory Embeddings"
                elif [[ "$name" == *"r1"* || "$name" == *"reason"* || "$name" == *"phi"* ]]; then
                    tag="🧠 Reasoning (CoT)"
                elif [[ "$name" == *"llama"* || "$name" == *"qwen"* ]]; then
                    tag="💬 Chat & Search"
                fi
                printf "    • %-30s %-10s [%s]\n" "$name" "$size" "$tag"
            done
        else
            echo "    (No models currently downloaded. Run 'palexus-setup --pull-core')"
        fi
        echo ""
        echo "  [Resident Models in RAM]:"
        local resident
        resident=$("$ollama_bin" ps 2>/dev/null | tail -n +2)
        if [[ -n "$resident" ]]; then
            echo "$resident" | sed 's/^/    • /'
        else
            echo "    (None loaded - zero RAM standby)"
        fi
    else
        echo "  [AI Daemon]      Ollama is INACTIVE (Run 'palexus-setup --serve')"
    fi

    echo ""
    # 2. Palexus Core Daemon
    if systemctl is-active palexus >/dev/null 2>&1; then
        echo "  [Palexus Core]   Active (http://127.0.0.1:8000) ✔"
    else
        echo "  [Palexus Core]   Standby"
    fi

    # 3. Privacy & Stealth
    if resolvectl status 2>/dev/null | grep -q "9.9.9.9"; then
        echo "  [DNS-over-TLS]   Quad9 DoT (9.9.9.9:853) ACTIVE ✔"
    else
        echo "  [DNS-over-TLS]   Standard DNS"
    fi

    if systemctl is-active firewalld >/dev/null 2>&1; then
        echo "  [Firewall]       firewalld ACTIVE (Default Inbound Drop) ✔"
    else
        echo "  [Firewall]       Standby"
    fi
    echo "=============================================================================="
}

case "${1:-}" in
    --first-boot)
        run_first_boot
        ;;
    --pull-core)
        pull_core_models
        ;;
    --pull-model)
        if [[ -n "${2:-}" ]]; then
            ensure_ollama_running
            pull_single_model "$2"
        else
            pull_core_models
        fi
        ;;
    --pull-hf)
        if [[ -n "${2:-}" ]]; then
            ensure_ollama_running
            pull_single_model "$2"
        else
            echo "Usage: palexus-setup --pull-hf <hf.co/user/repo>"
        fi
        ;;
    --interactive|-i|--menu)
        interactive_menu
        ;;
    --serve)
        ensure_ollama_running
        echo "Ollama daemon running on 127.0.0.1:11434."
        ;;
    --warm)
        warm_models
        ;;
    --flush)
        flush_models
        ;;
    --status)
        show_status
        ;;
    --reset-firstboot)
        rm -f "${FIRSTBOOT_FLAG}"
        echo "First-boot marker removed. Next session will trigger setup."
        ;;
    --help|-h)
        show_help
        ;;
    *)
        show_status
        echo ""
        echo "Run 'palexus-setup --help' or 'palexus-setup --interactive' to manage models."
        ;;
esac
