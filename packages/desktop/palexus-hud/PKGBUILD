pkgname=palexus-hud
pkgver=0.1.0
pkgrel=9
pkgdesc="Native Qt6/QML Material You Command HUD, Palexus Settings Control Center, Brain Notes, Metallic Icon Suites, and Neural Governor"
arch=('any')
url="https://github.com/earnerbaymalay/synapseOS"
license=('MIT')
provides=('synapse-hud' 'palexus-hud')
conflicts=('synapse-hud')
depends=('python' 'python-pyqt6' 'qt6-declarative' 'qt6-svg' 'qt6-5compat' 'kitty')
source=(
  "palexus-hud"
  "palexus-settings"
  "palexus-notes"
  "palexus-setup"
  "palexus-welcome"
  "palexus-shortcuts"
  "palexus-power"
  "palexus-stealth"
  "sec-status"
  "audio-switch"
  "palexus-hardware"
  "palexus-governor"
  "palexus-governor.service"
  "Main.qml"
  "CommandCategoryCard.qml"
  "palexus-hud.desktop"
  "palexus-settings.desktop"
  "palexus-notes.desktop"
  "palexus-welcome.desktop"
  "master_plate_960.png"
  "Welcome.qml"
  "palexus_chrome_logo.png"
  "palexus_chrome_spin_360.gif"
  "palexus_chrome_spin_360.webp"
  "palexus_chrome_plate_4d.png"
  "palexus_chrome_plate_spin_360.webp"
  "generate_spinning_chrome.py"
)
sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
)

package() {
  # Primary Palexus binaries & backwards-compatible Synapse symlinks
  # Provides: synapse-setup, synapse-notes, synapse-settings, synapse-welcome, palexus-setup, palexus-notes, palexus-settings, palexus-welcome
  local tools=("hud" "settings" "notes" "setup" "welcome" "shortcuts" "power" "stealth" "hardware" "governor")
  for t in "${tools[@]}"; do
    install -Dm755 "${srcdir}/palexus-${t}" "${pkgdir}/usr/bin/palexus-${t}"
    ln -sf "palexus-${t}" "${pkgdir}/usr/bin/synapse-${t}"
  done

  install -Dm755 "${srcdir}/sec-status" "${pkgdir}/usr/bin/sec-status"
  install -Dm755 "${srcdir}/audio-switch" "${pkgdir}/usr/bin/audio-switch"
  install -Dm644 "${srcdir}/palexus-governor.service" "${pkgdir}/usr/lib/systemd/system/palexus-governor.service"
  ln -sf "palexus-governor.service" "${pkgdir}/usr/lib/systemd/system/synapse-governor.service"

  ln -sf "palexus-hud" "${pkgdir}/usr/bin/palexus-palette"
  ln -sf "palexus-hud" "${pkgdir}/usr/bin/synapse-palette"

  # QML Assets & Liquid Chrome Master Plate
  install -dm755 "${pkgdir}/usr/share/palexus-hud"
  install -Dm644 "${srcdir}/Main.qml" "${pkgdir}/usr/share/palexus-hud/Main.qml"
  install -Dm644 "${srcdir}/CommandCategoryCard.qml" "${pkgdir}/usr/share/palexus-hud/CommandCategoryCard.qml"
  install -Dm644 "${srcdir}/Welcome.qml" "${pkgdir}/usr/share/palexus-hud/Welcome.qml"
  install -Dm644 "${srcdir}/master_plate_960.png" "${pkgdir}/usr/share/palexus-hud/master_plate_960.png"
  install -Dm644 "${srcdir}/palexus_chrome_logo.png" "${pkgdir}/usr/share/palexus-hud/palexus_chrome_logo.png"
  install -Dm644 "${srcdir}/palexus_chrome_spin_360.gif" "${pkgdir}/usr/share/palexus-hud/palexus_chrome_spin_360.gif"
  install -Dm644 "${srcdir}/palexus_chrome_spin_360.webp" "${pkgdir}/usr/share/palexus-hud/palexus_chrome_spin_360.webp"
  install -Dm644 "${srcdir}/palexus_chrome_plate_4d.png" "${pkgdir}/usr/share/palexus-hud/palexus_chrome_plate_4d.png"
  install -Dm644 "${srcdir}/palexus_chrome_plate_spin_360.webp" "${pkgdir}/usr/share/palexus-hud/palexus_chrome_plate_spin_360.webp"
  ln -sf "palexus_chrome_logo.png" "${pkgdir}/usr/share/palexus-hud/synapse_chrome_logo.png"
  ln -sf "palexus_chrome_spin_360.gif" "${pkgdir}/usr/share/palexus-hud/synapse_chrome_spin_360.gif"
  ln -sf "palexus_chrome_spin_360.webp" "${pkgdir}/usr/share/palexus-hud/synapse_chrome_spin_360.webp"
  ln -sf "palexus_chrome_plate_4d.png" "${pkgdir}/usr/share/palexus-hud/synapse_chrome_plate_4d.png"
  ln -sf "palexus_chrome_plate_spin_360.webp" "${pkgdir}/usr/share/palexus-hud/synapse_chrome_plate_spin_360.webp"
  install -Dm755 "${srcdir}/generate_spinning_chrome.py" "${pkgdir}/usr/share/palexus-hud/generate_spinning_chrome.py"

  # Symlink for legacy synapse-hud directory
  ln -sf "palexus-hud" "${pkgdir}/usr/share/synapse-hud"

  # Desktop Entries
  local des=("hud" "settings" "notes" "welcome")
  for d in "${des[@]}"; do
    install -Dm644 "${srcdir}/palexus-${d}.desktop" "${pkgdir}/usr/share/applications/palexus-${d}.desktop"
    ln -sf "palexus-${d}.desktop" "${pkgdir}/usr/share/applications/synapse-${d}.desktop"
  done

  # Metallic Icon Suites
  if [[ -d "${startdir}/icons" ]]; then
    install -dm755 "${pkgdir}/usr/share/icons"
    cp -af "${startdir}/icons/." "${pkgdir}/usr/share/icons/"
  fi
}
