[Unit]
Description=PalexusOS PL1/PL2 Thermal & EPP Governor
Documentation=file:///etc/palexus/governor.toml
After=multi-user.target throttled.service ollama.service
Wants=throttled.service

[Service]
Type=simple
ExecStart=/usr/bin/palexus-governor run
Restart=on-failure
RestartSec=3s
# SIGTERM makes the daemon restore boot-time EPP and power limits before exiting.
KillSignal=SIGTERM
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
Nice=-5

# --- Hardening: read-only system, writable only where limits are set ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# cpufreq EPP/governor, intel-rapl(-mmio) package constraints, throttled limits.
# "-" skips paths that do not exist on this machine (e.g. no throttled, no RAPL).
ReadWritePaths=-/sys/devices/system/cpu -/sys/devices/virtual/powercap -/etc/throttled.conf

# --- Network: loopback Ollama only ---
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
