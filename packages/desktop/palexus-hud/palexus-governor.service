[Unit]
Description=PalexusOS Neural Hardware & Thermal Performance Governor
After=multi-user.target throttled.service ollama.service
Wants=throttled.service

[Service]
Type=simple
ExecStart=/usr/bin/palexus-governor
Restart=on-failure
RestartSec=3s
StandardOutput=journal
StandardError=journal
Nice=-5

[Install]
WantedBy=multi-user.target

