#!/usr/bin/env python3
"""palexus-hud — Native Qt6/QML Command HUD and Quickfire Cockpit for PalexusOS.

Provides an instant-launch, Material You / Catppuccin chamfered HUD with
mouse-clickable cards and keyboard hotkeys, bound universally to Super+Space.
"""

import os
import sys
import subprocess
from pathlib import Path

from PyQt6.QtCore import QObject, pyqtSlot, QUrl
from PyQt6.QtGui import QGuiApplication
from PyQt6.QtQml import QQmlApplicationEngine

# Same model as the ask-qwen shell helper in ~/.bashrc
AI_MODEL = "qwen2.5-coder:latest"


class HudBackend(QObject):
    def __init__(self, app, parent=None):
        super().__init__(parent)
        self.app = app

    @pyqtSlot(str)
    def launch(self, action: str):
        if not action:
            self.app.quit()
            return

        # Prepare comprehensive environment ensuring all scripts and tools are discovered
        env = os.environ.copy()
        script_dir = Path(__file__).resolve().parent
        theme_dir = script_dir.parent / "palexus-themes"
        core_dir = script_dir.parent.parent / "core" / "palexus-core"
        local_bin = Path.home() / ".local/bin"

        path_elements = [str(local_bin), str(script_dir), str(theme_dir), str(core_dir), "/usr/local/bin", "/usr/bin", "/bin"]
        env["PATH"] = ":".join(path_elements) + ":" + env.get("PATH", "")
        if "DISPLAY" not in env:
            env["DISPLAY"] = ":0"
        if "WAYLAND_DISPLAY" not in env:
            env["WAYLAND_DISPLAY"] = "wayland-0"
        env["QT_QUICK_BACKEND"] = "software"

        if action.startswith("AI_PROMPT:"):
            prompt = action[len("AI_PROMPT:"):].strip()
            if prompt.startswith("?"):
                prompt = prompt[1:].strip()
            elif prompt.lower().startswith("ai "):
                prompt = prompt[3:].strip()
            if prompt:
                # ~/.bashrc stops at once for non-interactive shells, so its ask-* aliases are
                # never defined here: call ollama directly. The prompt travels as an argument,
                # never inside the script text, so quotes and $(...) in it stay literal.
                subprocess.Popen([
                    "kitty", "--title", f"AI Prompt: {prompt}",
                    "bash", "-c",
                    'ollama run "$1" "$2"; echo; read -r -p "Press enter to close..."',
                    "palexus-ai-prompt", AI_MODEL, prompt,
                ], env=env, start_new_session=True)
        else:
            # Execute command detached with prepared environment
            subprocess.Popen(["bash", "-c", action], env=env, start_new_session=True)

        self.app.quit()

    @pyqtSlot()
    def close(self):
        self.app.quit()

def get_variant() -> str:
    theme_file = Path.home() / ".config/palexus/theme"
    if theme_file.exists():
        try:
            return theme_file.read_text().strip()
        except Exception:
            pass
    return "monolith-mauve"

def main():
    app = QGuiApplication(sys.argv)
    app.setDesktopFileName("palexus-hud")
    engine = QQmlApplicationEngine()

    backend = HudBackend(app)
    engine.rootContext().setContextProperty("backend", backend)

    qml_file = Path(__file__).resolve().parent / "Main.qml"
    if not qml_file.exists():
        qml_file = Path("/usr/share/palexus-hud/Main.qml")

    engine.load(QUrl.fromLocalFile(str(qml_file)))

    if not engine.rootObjects():
        sys.exit(1)

    root = engine.rootObjects()[0]
    root.setProperty("variant", get_variant())
    root.launchCommand.connect(backend.launch)
    root.closeHud.connect(backend.close)

    sys.exit(app.exec())

if __name__ == "__main__":
    main()
