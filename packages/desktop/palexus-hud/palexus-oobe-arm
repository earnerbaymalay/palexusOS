#!/usr/bin/env bash
# palexus-oobe-arm — run once by the installer (Calamares shellprocess@oobe, in the target chroot).
# Arms first-boot setup: the next boot logs straight into the setup wizard, which creates the
# real account and then removes everything this script adds (see palexus-oobe-apply --finalize).
set -euo pipefail

OOBE_USER=palexus-oobe

install -d -m 0755 /var/lib/palexus
if ! id -u "$OOBE_USER" >/dev/null 2>&1; then
    useradd --system --create-home --home-dir /var/lib/palexus-oobe --shell /bin/bash \
        --groups video,input,audio "$OOBE_USER"
fi
passwd -l "$OOBE_USER" >/dev/null

install -Dm644 /usr/share/palexus-hud/palexus-oobe.desktop /usr/share/wayland-sessions/palexus-oobe.desktop

install -d -m 0755 /etc/sddm.conf.d
cat > /etc/sddm.conf.d/50-palexus-oobe.conf << CONF
# First-boot setup only; removed by palexus-oobe-apply --finalize
[Autologin]
User=${OOBE_USER}
Session=palexus-oobe.desktop
Relogin=false
CONF

# The setup user may run exactly one command as root, with no arguments
install -d -m 0750 /etc/sudoers.d
rule=/etc/sudoers.d/50-palexus-oobe
printf '%s ALL=(root) NOPASSWD: /usr/lib/palexus/palexus-oobe-apply ""\n' "$OOBE_USER" > "$rule"
chmod 0440 "$rule"
if command -v visudo >/dev/null 2>&1 && ! visudo -cqf "$rule"; then
    rm -f "$rule"
    echo "palexus-oobe-arm: sudoers rule failed validation" >&2
    exit 1
fi

touch /var/lib/palexus/oobe-pending

# Text-mode fallback on tty2 in case the graphical setup can't start
systemctl enable palexus-oobe-recovery.service
