# Maintainer: SynapseOS Engineering Team <maintainers@synapseos.org>
pkgname=synapse-plymouth
pkgver=0.2.0
pkgrel=2
install=synapse-plymouth.install
pkgdesc="SynapseOS Plymouth boot splash: the official SynapseOS boot animation"
arch=('any')
url="https://github.com/earnerbaymalay/synapseOS"
license=('MIT')
depends=('plymouth')
makedepends=('ffmpeg')
source=('synapse-boot.mp4' 'synapseos.script.in' '95-synapse-plymouth.hook')
sha256sums=('SKIP' 'SKIP' 'SKIP')

# The frames end up in the initramfs, so keep the sequence small:
# 720x405 (Plymouth scales it to fit), 128-colour palette PNG (the footage is
# mostly near-black chrome plus one purple; ~22 MB vs 127 MB for RGB), and
# 50/3 fps so each frame spans exactly 3 of Plymouth's 50 Hz refresh ticks.
# Playback keeps the video's real 10 s duration.
_width=720
_height=405
_ticks=3

build() {
  rm -rf frames
  mkdir frames
  ffmpeg -v error -i synapse-boot.mp4 -an \
    -filter_complex "fps=50/${_ticks},scale=${_width}:${_height}:flags=lanczos,split[a][b];[a]palettegen=max_colors=128:stats_mode=full[p];[b][p]paletteuse=dither=sierra2_4a" \
    -pix_fmt pal8 -compression_level 9 -start_number 0 frames/frame-%04d.png
  # Full-colour last frame, held on screen until the login screen appears
  ffmpeg -v error -sseof -0.5 -i synapse-boot.mp4 -an \
    -vf "scale=${_width}:${_height}:flags=lanczos" -update 1 -compression_level 9 frames/final.png
}

package() {
  install -Dm644 95-synapse-plymouth.hook "$pkgdir/usr/share/libalpm/hooks/95-synapse-plymouth.hook"
  local dir="$pkgdir/usr/share/plymouth/themes/synapseos"
  local frames
  install -dm755 "$dir"
  install -m644 frames/*.png "$dir/"
  frames=$(find frames -name 'frame-*.png' | wc -l)
  sed -e "s/@FRAMES@/$frames/" \
      -e "s/@TICKS@/${_ticks}/" \
      -e "s/@WIDTH@/${_width}/" \
      -e "s/@HEIGHT@/${_height}/" \
      synapseos.script.in > "$dir/synapseos.script"
  cat > "$dir/synapseos.plymouth" << PLY
[Plymouth Theme]
Name=SynapseOS
Description=The official SynapseOS boot animation
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/synapseos
ScriptFile=/usr/share/plymouth/themes/synapseos/synapseos.script
PLY
}
