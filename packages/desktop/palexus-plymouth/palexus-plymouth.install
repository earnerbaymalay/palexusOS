# Only selects the theme; 95-palexus-plymouth.hook rebuilds the initramfs after the
# transaction, so mkinitcpio never runs mid-upgrade.
_retired='palexusos-mauve palexusos-tungsten palexusos-crimson palexusos-sapphire palexusos-emerald'

_select_palexusos() {
    command -v plymouth-set-default-theme >/dev/null 2>&1 || return 0
    if ! plymouth-set-default-theme palexusos; then
        echo ":: WARNING: couldn't select the PalexusOS boot animation."
        echo "   Run: sudo plymouth-set-default-theme -R palexusos"
    fi
}

post_install() {
    [ "$(plymouth-set-default-theme 2>/dev/null)" = palexusos ] || _select_palexusos
}

post_upgrade() {
    if [ -r /etc/plymouth/plymouthd.conf ]; then
        current="$(grep -E '^Theme=' /etc/plymouth/plymouthd.conf 2>/dev/null | cut -d= -f2)"
    fi
    for old in $_retired; do
        if [ "$current" = "$old" ]; then
            echo ":: Replacing retired boot theme $old with the PalexusOS boot animation"
            _select_palexusos
        fi
    done
}
