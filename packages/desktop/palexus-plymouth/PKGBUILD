# Maintainer: PalexusOS Engineering Team <maintainers@palexusos.org>
pkgname=palexus-plymouth
pkgver=0.2.0
pkgrel=5
install=palexus-plymouth.install
pkgdesc="PalexusOS Plymouth boot splash: the official PalexusOS boot animation"
arch=('any')
url="https://github.com/earnerbaymalay/palexusOS"
license=('MIT')
provides=('synapse-plymouth' 'palexus-plymouth')
conflicts=('synapse-plymouth')
depends=('plymouth')
makedepends=('ffmpeg')
source=('palexus-boot.mp4' 'palexusos.script.in' '95-palexus-plymouth.hook')
sha256sums=('f1f5830a7a105310aa6916100c162a4884a6312bbf45be39ffe59aa04b7545b1'
            '26eb43f5a95fc44abf4045f87d4f36cdd8d4899e9c1d485e8428f92bb3974554'
            '5fcfd0c8eb2de7594108dd205c18c45b0e402b654fef367a83171ecafe2636a5')

# The frames end up in every initramfs, so keep the sequence small (budget 8 MB;
# this gives about 7.4 MB, down from 22 MB at 720x405 and 16.7 fps):
# - 480x270: Plymouth scales it to fit the screen; the footage is soft chrome, so
#   the upscale costs little, while 640x360 needed 64 colours and showed banding.
# - 128-colour palette PNG without dithering: dither noise doubles PNG size.
# - 12.5 fps (50/4): each frame spans exactly 4 of Plymouth's 50 Hz refresh
#   ticks, so the pacing stays even. Playback keeps the video's real duration (8 s).
_width=480
_height=270
_ticks=4

build() {
  rm -rf frames
  mkdir frames
  ffmpeg -v error -i palexus-boot.mp4 -an \
    -filter_complex "fps=50/${_ticks},scale=${_width}:${_height}:flags=lanczos,split[a][b];[a]palettegen=max_colors=128:stats_mode=full[p];[b][p]paletteuse=dither=none" \
    -pix_fmt pal8 -compression_level 9 -start_number 0 frames/frame-%04d.png
  # Full-colour last frame, held on screen until the login screen appears
  ffmpeg -v error -sseof -0.5 -i palexus-boot.mp4 -an \
    -vf "scale=${_width}:${_height}:flags=lanczos" -update 1 -compression_level 9 frames/final.png
}

package() {
  install -Dm644 95-palexus-plymouth.hook "$pkgdir/usr/share/libalpm/hooks/95-palexus-plymouth.hook"
  local dir="$pkgdir/usr/share/plymouth/themes/palexusos"
  local frames
  install -dm755 "$dir"
  install -m644 frames/*.png "$dir/"
  frames=$(find frames -name 'frame-*.png' | wc -l)
  sed -e "s/@FRAMES@/$frames/" \
      -e "s/@TICKS@/${_ticks}/" \
      -e "s/@WIDTH@/${_width}/" \
      -e "s/@HEIGHT@/${_height}/" \
      palexusos.script.in > "$dir/palexusos.script"
  cat > "$dir/palexusos.plymouth" << PLY
[Plymouth Theme]
Name=PalexusOS
Description=The official PalexusOS boot animation
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/palexusos
ScriptFile=/usr/share/plymouth/themes/palexusos/palexusos.script
PLY

  # Legacy compatibility symlinks
  ln -sf "palexusos" "$pkgdir/usr/share/plymouth/themes/synapseos"
}
