    def next_page(self):
        idx = self.stack.currentIndex()
        if idx < self.TOTAL_STEPS - 1:
            self.stack.setCurrentIndex(idx + 1)
            self.update_nav()
        else:
            self.apply_and_finish()

    def prev_page(self):
        idx = self.stack.currentIndex()
        if idx > 0:
            self.stack.setCurrentIndex(idx - 1)
            self.update_nav()

    def update_step_pills(self):
        cur_idx = self.stack.currentIndex()
        for i, lbl in enumerate(self.step_labels):
            if i == cur_idx:
                lbl.setStyleSheet("background-color: #cba6f7; color: #11111b; border-radius: 4px; padding: 2px 4px;")
            elif i < cur_idx:
                lbl.setStyleSheet("background-color: #1e1e2e; color: #a6e3a1; border: 1px solid #313244; border-radius: 4px; padding: 2px 4px;")
            else:
                lbl.setStyleSheet("background-color: #11111b; color: #6c7086; border: 1px solid #1e1e2e; border-radius: 4px; padding: 2px 4px;")

