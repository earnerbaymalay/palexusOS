    # -----------------------------------------------------------------
    # APPLY SETTINGS & FINISH
    # -----------------------------------------------------------------
    def apply_and_finish(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)

        # 1. Save Full Operator Profile & Feature Combos
        try:
            profile = {
                "operator": self.operator_name,
                "hostname": self.hostname,
                "ai_copilot": self.ai_name,
                "profile_archetype": self.selected_profile,
                "feature_combos": self.combos,
                "icon_theme": self.selected_icon_theme,
                "wallpaper_variant": self.selected_wallpaper,
                "screensaver_mode": self.selected_screensaver
            }
            with open(os.path.join(CONFIG_DIR, "operator_profile.json"), "w", encoding="utf-8") as f:
                json.dump(profile, f, indent=2)
            with open(os.path.join(CONFIG_DIR, "operator"), "w", encoding="utf-8") as f:
                f.write(self.operator_name + "\n")
        except Exception:
            pass

        # 2. Apply Metallic Icon Theme (GTK / XFCE / GNOME)
        try:
            subprocess.run([
                "xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName", "-s", self.selected_icon_theme
            ], check=False)
            with open(os.path.join(CONFIG_DIR, "icon_theme"), "w") as f:
                f.write(self.selected_icon_theme + "\n")

            gtk3_file = os.path.expanduser("~/.config/gtk-3.0/settings.ini")
            gtk4_file = os.path.expanduser("~/.config/gtk-4.0/settings.ini")
            for gtk_file in (gtk3_file, gtk4_file):
                try:
                    update_gtk_settings(gtk_file, self.selected_icon_theme)
                except Exception:
                    pass

            if shutil.which("gsettings"):
                subprocess.run([
                    "gsettings", "set", "org.gnome.desktop.interface", "icon-theme", self.selected_icon_theme
                ], check=False)
        except Exception:
            pass

        # 3. Apply Wallpaper & Accent
        try:
            subprocess.run(["synapse-theme", self.selected_wallpaper], check=False)
        except Exception:
            pass

        # 4. Save Screensaver Preference
        try:
            with open(os.path.join(CONFIG_DIR, "screensaver_mode"), "w") as f:
                f.write(self.selected_screensaver + "\n")
        except Exception:
            pass

        # 5. Mark Onboarding Complete
        try:
            with open(ONBOARDING_FLAG, "w") as f:
                f.write("completed\n")
        except Exception:
            pass

        # 6. Launch Command HUD Cockpit
        try:
            hud_exe = resolve_command_path("synapse-hud")
            subprocess.Popen([hud_exe], start_new_session=True)
        except Exception:
            pass

        self.close()


def main():
    if "--autostart" in sys.argv:
        if os.path.exists(ONBOARDING_FLAG):
            sys.exit(0)
    app = QApplication(sys.argv)
    wizard = OnboardingWizard()
    wizard.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
