#!/usr/bin/env python3
"""synapse-welcome — SynapseOS first-run setup.
Author: earnerbaymalay

A short, linear QtQuick wizard that runs once per user after the first login:

  First boot (--oobe) : Welcome -> Account -> Look -> Assistant -> Ready
                        then hands off to the login screen with the new account selected
  Live ISO            : Welcome (Try / Install) -> Look -> Ready
  In session          : Welcome -> Look -> Assistant -> Ready   (Super+W, or first login)

Design rules:
  - Nothing is downloaded or sent off-device without an explicit choice on screen.
  - Status shown to the user is read from the running system, never hard-coded.
  - Skipping is always possible and never applies hidden changes.
"""

import os
import sys
import json
import re
import pwd
import shutil
import socket
import threading
import urllib.request
import urllib.error
import subprocess
from pathlib import Path

from PyQt6.QtCore import QObject, pyqtProperty, pyqtSlot, pyqtSignal, QUrl
from PyQt6.QtGui import QGuiApplication
from PyQt6.QtQml import QQmlApplicationEngine

CONFIG_DIR = os.path.expanduser("~/.config/synapse")
ONBOARDING_FLAG = os.path.join(CONFIG_DIR, ".onboarding_complete")
# Read by `synapse-setup --first-boot`; its absence means "do not download models"
AI_MODELS_FILE = os.path.join(CONFIG_DIR, "ai_models")
LIVE_MARKER = "/etc/sudoers.d/00-synapse-live"
OOBE_SEED_DIR = "/var/lib/synapse/oobe-seed"
OOBE_HELPER = "/usr/lib/synapse/synapse-oobe-apply"
USERNAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
HOSTNAME_RE = re.compile(r"^(?!-)[a-zA-Z0-9-]{1,63}(?<!-)$")
RESERVED_USERS = {"root", "synapse", "synapse-oobe", "sddm", "ollama", "git", "synapse-daemon", "nobody"}
WALLPAPER_DIR = Path("/usr/share/backgrounds/synapseos")
ICON_DIR = Path("/usr/share/icons")

CLAUDE_MODEL = "claude-opus-5-5"

# Mirrors THEMES in synapse-theme; monolith has no crimson plate
SCENES = ["monolith", "tower", "carbon"]
ACCENTS = ["mauve", "tungsten", "crimson", "sapphire", "emerald"]
VARIANTS = {f"{s}-{a}" for s in SCENES for a in ACCENTS} - {"monolith-crimson"}
DEFAULT_VARIANT = "monolith-mauve"

ICON_THEMES = ["Synapse-Liquid-Chrome", "Synapse-Smoked-Obsidian",
               "Synapse-Radial-Tungsten", "Synapse-Aerospace-Billet"]
ICON_SAMPLES = ["utilities-terminal", "system-file-manager", "web-browser", "synapse-settings"]

# Local model tiers, kept in step with synapse-setup
MODEL_TIERS = {
    "light":    {"models": ["nomic-embed-text:latest", "qwen2.5-coder:1.5b", "llama3.2:latest"], "size_gb": 3.3},
    "standard": {"models": ["nomic-embed-text:latest", "qwen2.5-coder:latest", "llama3.2:latest"], "size_gb": 7.0},
}

# Tools the wizard may open; QML never passes a raw command line
TOOLS = {
    "installer": ["calamares", "-d"],
    "audit": ["sec-status"],
    "shortcuts": ["synapse-shortcuts"],
    "settings": ["synapse-settings"],
    "hud": ["synapse-hud"],
}


def find_chrome_logo():
    """Find the liquid chrome logo used by the boot splash and greeter."""
    script_dir = Path(__file__).resolve().parent
    candidates = [
        script_dir / "synapse_chrome_logo.png",
        script_dir / "../synapse-plymouth/synapse_chrome_logo.png",
        Path("/usr/share/synapse-hud/synapse_chrome_logo.png"),
        Path("/usr/share/synapseos/branding/synapse_chrome_logo.png"),
        script_dir / "master_plate_960.png",
        Path("/usr/share/synapse-hud/master_plate_960.png"),
    ]
    for c in candidates:
        p = Path(c).resolve()
        if p.is_file() and p.stat().st_size > 0:
            return str(p)
    return ""


def resolve_command_path(cmd_name: str) -> str:
    """Find command either in system PATH or in repository directories."""
    found = shutil.which(cmd_name)
    if found:
        return found
    script_dir = Path(__file__).resolve().parent
    local_candidates = [
        script_dir / cmd_name,
        script_dir.parent / "synapse-themes" / cmd_name,
        script_dir.parent / "synapse-hud" / cmd_name,
    ]
    for c in local_candidates:
        if c.is_file():
            return str(c)
    return cmd_name


def wallpaper_path(variant: str) -> str:
    name = f"synapse-{variant}.jpg"
    for d in (WALLPAPER_DIR, Path(__file__).resolve().parent.parent / "synapse-themes"):
        p = d / name
        if p.is_file():
            return str(p)
    return ""


def icon_path(theme: str, icon: str) -> str:
    for d in (ICON_DIR, Path(__file__).resolve().parent / "icons"):
        p = d / theme / "scalable" / "apps" / f"{icon}.svg"
        if p.is_file() and p.stat().st_size > 0:
            return str(p)
    return ""


def read_pref(name: str, allowed, default: str, dirs) -> str:
    for d in dirs:
        try:
            v = Path(d, name).read_text().strip()
            if v in allowed:
                return v
        except OSError:
            pass
    return default


def username_from_name(name: str) -> str:
    first = re.sub(r"[^a-z0-9]", "", (name.strip().split() or [""])[0].lower())
    if first and not first[0].isalpha():
        first = "u" + first
    return first[:32]


def account_errors(full_name: str, username: str, password: str, confirm: str, hostname: str) -> dict:
    """Field -> message for everything wrong with the account form (empty when valid)."""
    errors = {}
    if any(c in full_name for c in ":,\n"):
        errors["fullName"] = "Your name can't contain commas or colons."
    if not username:
        errors["username"] = "Pick a username."
    elif not USERNAME_RE.match(username):
        errors["username"] = "Use lowercase letters, digits, - or _, starting with a letter."
    elif username in RESERVED_USERS:
        errors["username"] = "That name is reserved by the system."
    else:
        try:
            pwd.getpwnam(username)
            errors["username"] = "That username is already taken."
        except KeyError:
            pass
    if len(password) < 6:
        errors["password"] = "Use at least 6 characters."
    elif confirm != password:
        errors["confirm"] = "The passwords don't match."
    if not HOSTNAME_RE.match(hostname):
        errors["hostname"] = "Letters, digits and dashes only."
    return errors


def total_ram_gb() -> float:
    try:
        with open("/proc/meminfo", encoding="utf-8") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) / (1024 * 1024)
    except OSError:
        pass
    return 0.0


def display_name() -> str:
    user = os.environ.get("USER", "")
    try:
        import pwd
        gecos = pwd.getpwnam(user).pw_gecos.split(",")[0].strip()
        if gecos:
            return gecos.split()[0]
    except (KeyError, ImportError):
        pass
    return user or "there"


def file_contains(path: str, *needles: str) -> bool:
    try:
        text = Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    return all(n in text for n in needles)


def unit_active(unit: str) -> bool:
    if not shutil.which("systemctl"):
        return False
    try:
        return subprocess.run(["systemctl", "is-active", "--quiet", unit], timeout=3).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def security_checks() -> list:
    """Read the actual protection state; mirrors the checks in sec-status."""
    firewall = unit_active("firewalld")
    dot = file_contains("/etc/systemd/resolved.conf.d/quad9-dot.conf", "9.9.9.9", "DNSOverTLS=yes")
    mac = file_contains("/etc/NetworkManager/conf.d/00-synapseos-stealth.conf",
                        "wifi.scan-rand-mac-address=yes", "wifi.cloned-mac-address=random")
    ipv6 = file_contains("/etc/NetworkManager/conf.d/00-synapseos-stealth.conf", "ipv6.ip6-privacy=2") \
        or file_contains("/etc/sysctl.d/99-synapseos.conf", "use_tempaddr = 2")
    return [
        {"label": "Firewall", "ok": firewall,
         "detail": "firewalld is running and drops unsolicited incoming traffic." if firewall
                   else "firewalld is not running. Open the audit for details."},
        {"label": "Encrypted DNS", "ok": dot,
         "detail": "DNS lookups go to Quad9 over TLS (port 853)." if dot
                   else "DNS-over-TLS config not found; lookups may be unencrypted."},
        {"label": "MAC randomization", "ok": mac,
         "detail": "Wi-Fi scans and connections use a random hardware address." if mac
                   else "MAC randomization config not found."},
        {"label": "IPv6 privacy addresses", "ok": ipv6,
         "detail": "Temporary IPv6 addresses (RFC 4941) are preferred." if ipv6
                   else "IPv6 privacy extensions not configured."},
        {"label": "No telemetry", "ok": True,
         "detail": "SynapseOS ships no usage reporting. The AI assistant only goes online if you pick a cloud engine."},
    ]


def write_private(path: str, content: str):
    """Write a file readable only by the owner (API keys)."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(content)
    os.chmod(path, 0o600)


def update_gtk_settings(settings_path: str, icon_theme: str):
    """Write or update gtk-icon-theme-name under [Settings] in GTK settings.ini."""
    os.makedirs(os.path.dirname(settings_path), exist_ok=True)
    lines = []
    if os.path.exists(settings_path):
        try:
            with open(settings_path, "r", encoding="utf-8") as f:
                lines = f.readlines()
        except Exception:
            lines = []

    settings_section_idx = -1
    icon_theme_idx = -1
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped == "[Settings]":
            settings_section_idx = i
        elif stripped.startswith("gtk-icon-theme-name") and settings_section_idx != -1:
            icon_theme_idx = i
            break
        elif stripped.startswith("[") and settings_section_idx != -1 and i > settings_section_idx:
            break

    entry = f"gtk-icon-theme-name = {icon_theme}\n"
    if icon_theme_idx != -1:
        lines[icon_theme_idx] = entry
    elif settings_section_idx != -1:
        lines.insert(settings_section_idx + 1, entry)
    else:
        if lines and not lines[-1].endswith("\n"):
            lines.append("\n")
        lines.append("[Settings]\n")
        lines.append(entry)

    with open(settings_path, "w", encoding="utf-8") as f:
        f.writelines(lines)


def check_claude_key(api_key: str) -> tuple:
    """Validate a key with a model lookup (no tokens spent). Returns (ok, message)."""
    req = urllib.request.Request(
        f"https://api.anthropic.com/v1/models/{CLAUDE_MODEL}",
        headers={"x-api-key": api_key, "anthropic-version": "2023-06-01"},
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return True, f"Key works. {data.get('display_name', CLAUDE_MODEL)} is available."
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            return False, "The key was rejected. Check it was copied in full."
        if e.code == 404:
            return False, f"The key works but this account can't use {CLAUDE_MODEL}."
        return False, f"Anthropic returned HTTP {e.code}. Try again in a moment."
    except (urllib.error.URLError, socket.timeout, OSError):
        return False, "Couldn't reach api.anthropic.com. Check your network connection."


class WelcomeBackend(QObject):
    stateChanged = pyqtSignal()
    keyTestChanged = pyqtSignal()
    finished = pyqtSignal()
    _keyResult = pyqtSignal(bool, str)
    accountChanged = pyqtSignal()
    applyChanged = pyqtSignal()
    _applyResult = pyqtSignal(bool, str)

    def __init__(self, app, parent=None, oobe=False):
        super().__init__(parent)
        self.app = app
        self._is_oobe = oobe
        self._is_live = os.path.exists(LIVE_MARKER) and not oobe
        self._chrome_logo_path = find_chrome_logo()
        self._operator = os.environ.get("USER", "operator")
        self._display_name = display_name()
        try:
            self._hostname = socket.gethostname() or "synapse"
        except Exception:
            self._hostname = "synapse"
        self._ram_gb = total_ram_gb()
        self._reduce_motion = os.environ.get("SYNAPSE_REDUCE_MOTION", "") not in ("", "0")

        pref_dirs = [OOBE_SEED_DIR] if oobe else [CONFIG_DIR]
        self._original_variant = read_pref("theme", VARIANTS, DEFAULT_VARIANT, pref_dirs)
        self._variant = self._original_variant
        self._icon_theme = read_pref("icon_theme", ICON_THEMES, "Synapse-Liquid-Chrome", pref_dirs)

        # First-boot account form
        self._full_name = ""
        self._username = ""
        self._username_edited = False
        self._password = ""
        self._confirm = ""
        self._new_hostname = "synapse"
        self._hostname_edited = False
        self._apply_state = "idle"   # idle | working | done | error
        self._apply_message = ""

        # Local-first: nothing leaves the device unless the user picks the cloud engine
        self._ai_engine = "local"
        self._model_tier = "standard" if self._ram_gb >= 12 else "light"
        self._download_models = not self._is_live
        self._claude_key = ""
        self._key_state = "idle"   # idle | testing | ok | error
        self._key_message = ""
        self._security = security_checks()

        self._keyResult.connect(self._on_key_result)
        self._applyResult.connect(self._on_apply_result)

    # ---- Identity & environment ----
    @pyqtProperty(bool, constant=True)
    def isLive(self):
        return self._is_live

    @pyqtProperty(bool, constant=True)
    def isOobe(self):
        return self._is_oobe

    # ---- First-boot account ----
    @pyqtProperty(str, notify=accountChanged)
    def fullName(self):
        return self._full_name

    @fullName.setter
    def fullName(self, val):
        if val != self._full_name:
            self._full_name = val
            if not self._username_edited:
                self._username = username_from_name(val)
            if not self._hostname_edited and self._username:
                self._new_hostname = f"{self._username}-synapse"[:63]
            self.accountChanged.emit()

    @pyqtProperty(str, notify=accountChanged)
    def username(self):
        return self._username

    @username.setter
    def username(self, val):
        if val != self._username:
            self._username = val
            self._username_edited = val != ""
            self.accountChanged.emit()

    @pyqtProperty(str, notify=accountChanged)
    def password(self):
        return self._password

    @password.setter
    def password(self, val):
        if val != self._password:
            self._password = val
            self.accountChanged.emit()

    @pyqtProperty(str, notify=accountChanged)
    def passwordConfirm(self):
        return self._confirm

    @passwordConfirm.setter
    def passwordConfirm(self, val):
        if val != self._confirm:
            self._confirm = val
            self.accountChanged.emit()

    @pyqtProperty(str, notify=accountChanged)
    def newHostname(self):
        return self._new_hostname

    @newHostname.setter
    def newHostname(self, val):
        if val != self._new_hostname:
            self._new_hostname = val
            self._hostname_edited = True
            self.accountChanged.emit()

    @pyqtProperty("QVariantMap", notify=accountChanged)
    def accountErrors(self):
        return account_errors(self._full_name, self._username, self._password, self._confirm, self._new_hostname)

    @pyqtProperty(str, notify=applyChanged)
    def applyState(self):
        return self._apply_state

    @pyqtProperty(str, notify=applyChanged)
    def applyMessage(self):
        return self._apply_message

    @pyqtProperty(bool, constant=True)
    def reduceMotion(self):
        return self._reduce_motion

    @pyqtProperty(str, constant=True)
    def chromeLogoPath(self):
        return self._chrome_logo_path

    @pyqtProperty(str, constant=True)
    def operator(self):
        return self._operator

    @pyqtProperty(str, constant=True)
    def displayName(self):
        return self._display_name

    @pyqtProperty(str, constant=True)
    def hostname(self):
        return self._hostname

    @pyqtProperty(float, constant=True)
    def ramGb(self):
        return round(self._ram_gb, 1)

    @pyqtProperty("QVariantList", constant=True)
    def securityChecks(self):
        return self._security

    # ---- Appearance ----
    @pyqtProperty(str, notify=stateChanged)
    def variant(self):
        return self._variant

    @pyqtProperty(str, notify=stateChanged)
    def scene(self):
        return self._variant.split("-")[0]

    @pyqtProperty(str, notify=stateChanged)
    def accentName(self):
        return self._variant.split("-")[1]

    @pyqtSlot(str, str, result=bool)
    def variantExists(self, scene, accent):
        return f"{scene}-{accent}" in VARIANTS

    @pyqtSlot(str, result=str)
    def wallpaperUrl(self, variant):
        p = wallpaper_path(variant)
        return QUrl.fromLocalFile(p).toString() if p else ""

    @pyqtSlot(str, str)
    def chooseVariant(self, scene, accent):
        v = f"{scene}-{accent}"
        if v not in VARIANTS:
            # Keep the scene, fall back to its first available accent
            v = next(f"{scene}-{a}" for a in ACCENTS if f"{scene}-{a}" in VARIANTS)
        if v != self._variant:
            self._variant = v
            self._preview_wallpaper(v)
            self.stateChanged.emit()

    @pyqtProperty("QStringList", constant=True)
    def iconThemes(self):
        return ICON_THEMES

    @pyqtProperty(str, notify=stateChanged)
    def iconTheme(self):
        return self._icon_theme

    @iconTheme.setter
    def iconTheme(self, val):
        if val in ICON_THEMES and val != self._icon_theme:
            self._icon_theme = val
            self.stateChanged.emit()

    @pyqtSlot(str, result="QStringList")
    def iconSamples(self, theme):
        return [QUrl.fromLocalFile(p).toString() for p in (icon_path(theme, i) for i in ICON_SAMPLES) if p]

    # ---- AI assistant ----
    @pyqtProperty(str, notify=stateChanged)
    def aiEngine(self):
        return self._ai_engine

    @aiEngine.setter
    def aiEngine(self, val):
        if val in ("local", "claude", "none") and val != self._ai_engine:
            self._ai_engine = val
            self.stateChanged.emit()

    @pyqtProperty(str, notify=stateChanged)
    def modelTier(self):
        return self._model_tier

    @modelTier.setter
    def modelTier(self, val):
        if val in MODEL_TIERS and val != self._model_tier:
            self._model_tier = val
            self.stateChanged.emit()

    @pyqtSlot(str, result=float)
    def tierSizeGb(self, tier):
        return MODEL_TIERS.get(tier, {}).get("size_gb", 0.0)

    @pyqtProperty(bool, notify=stateChanged)
    def downloadModels(self):
        return self._download_models

    @downloadModels.setter
    def downloadModels(self, val):
        if bool(val) != self._download_models:
            self._download_models = bool(val)
            self.stateChanged.emit()

    @pyqtProperty(str, constant=True)
    def claudeModel(self):
        return CLAUDE_MODEL

    @pyqtProperty(str, notify=stateChanged)
    def claudeApiKey(self):
        return self._claude_key

    @claudeApiKey.setter
    def claudeApiKey(self, val):
        val = val.strip()
        if val != self._claude_key:
            self._claude_key = val
            self._key_state, self._key_message = "idle", ""
            self.stateChanged.emit()
            self.keyTestChanged.emit()

    @pyqtProperty(str, notify=keyTestChanged)
    def keyTestState(self):
        return self._key_state

    @pyqtProperty(str, notify=keyTestChanged)
    def keyTestMessage(self):
        return self._key_message

    @pyqtSlot()
    def testClaudeKey(self):
        if not self._claude_key:
            self._key_state, self._key_message = "error", "Paste an API key first."
            self.keyTestChanged.emit()
            return
        if self._key_state == "testing":
            return
        self._key_state, self._key_message = "testing", "Checking key with Anthropic…"
        self.keyTestChanged.emit()
        key = self._claude_key
        threading.Thread(target=lambda: self._keyResult.emit(*check_claude_key(key)), daemon=True).start()

    def _on_key_result(self, ok, message):
        self._key_state = "ok" if ok else "error"
        self._key_message = message
        self.keyTestChanged.emit()

    # ---- Actions ----
    @pyqtSlot(str)
    def openTool(self, name):
        cmd = TOOLS.get(name)
        if not cmd:
            return
        try:
            subprocess.Popen([resolve_command_path(cmd[0])] + cmd[1:], start_new_session=True)
        except OSError:
            pass

    @pyqtSlot()
    def startInstaller(self):
        """Hand over to Calamares. Live choices so far are kept and migrated on install."""
        self._save_profile()
        self._apply_appearance()
        self.openTool("installer")
        self._quit()

    @pyqtSlot()
    def skip(self):
        """Leave without applying anything; restore the wallpaper if it was previewed."""
        if self._variant != self._original_variant:
            self._preview_wallpaper(self._original_variant)
        self._mark_complete("skipped")
        self._quit()

    @pyqtSlot()
    def finish(self):
        if self._is_oobe:
            self._finish_oobe()
            return
        os.makedirs(CONFIG_DIR, exist_ok=True)
        self._save_profile()
        self._apply_appearance()
        self._apply_ai()
        self._mark_complete("completed")
        self._quit()

    # ---- First boot ----
    def oobe_request(self) -> dict:
        local = self._ai_engine == "local" and self._download_models
        return {
            "full_name": self._full_name.strip(),
            "username": self._username,
            "password": self._password,
            "hostname": self._new_hostname,
            "variant": self._variant,
            "icon_theme": self._icon_theme,
            "ai_engine": self._ai_engine,
            "ai_models": MODEL_TIERS[self._model_tier]["models"] if local else [],
            "anthropic_key": self._claude_key if self._ai_engine == "claude" else "",
            "profile": {
                "claude_model": CLAUDE_MODEL if self._ai_engine == "claude" else "",
                "local_model_tier": self._model_tier if self._ai_engine == "local" else "",
            },
        }

    def _finish_oobe(self):
        if self._apply_state in ("working", "done"):
            return
        errors = self.accountErrors
        if errors:
            self._apply_state, self._apply_message = "error", next(iter(errors.values()))
            self.applyChanged.emit()
            return
        self._apply_state, self._apply_message = "working", "Creating your account…"
        self.applyChanged.emit()
        payload = json.dumps(self.oobe_request())
        threading.Thread(target=lambda: self._applyResult.emit(*self._run_helper(payload)), daemon=True).start()

    @staticmethod
    def _run_helper(payload: str) -> tuple:
        try:
            proc = subprocess.run(["sudo", "-n", OOBE_HELPER], input=payload, text=True,
                                  capture_output=True, timeout=120)
            out = proc.stdout.strip()
            result = json.loads(out.splitlines()[-1]) if out else {}
        except (OSError, subprocess.TimeoutExpired, ValueError, IndexError):
            return False, "Setup couldn't run its system helper. Restart the computer to try again."
        if result.get("ok"):
            return True, "Account created. Taking you to the login screen…"
        return False, result.get("error") or "Setup failed. Restart the computer to try again."

    def _on_apply_result(self, ok, message):
        self._apply_state = "done" if ok else "error"
        self._apply_message = message
        if ok:
            # Don't keep the password in memory longer than needed
            self._password = self._confirm = ""
        self.applyChanged.emit()

    # ---- Internals ----
    def _quit(self):
        self.finished.emit()
        self.app.quit()

    def _preview_wallpaper(self, variant):
        """Swap the wallpaper behind the wizard without persisting anything."""
        image = wallpaper_path(variant)
        if self._is_oobe:
            return  # the full-screen wizard paints the wallpaper itself
        if image and os.environ.get("SWAYSOCK") and shutil.which("swaymsg"):
            try:
                subprocess.Popen(["swaymsg", "-q", "output", "*", "bg", image, "fill"])
            except OSError:
                pass

    def _save_profile(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        profile = {
            "operator": self._operator,
            "hostname": self._hostname,
            "ai_engine": self._ai_engine,
            "claude_model": CLAUDE_MODEL if self._ai_engine == "claude" else "",
            "local_model_tier": self._model_tier if self._ai_engine == "local" else "",
            "icon_theme": self._icon_theme,
            "wallpaper_variant": self._variant,
            "screensaver_mode": "unified",
        }
        try:
            with open(os.path.join(CONFIG_DIR, "operator_profile.json"), "w", encoding="utf-8") as f:
                json.dump(profile, f, indent=2)
            with open(os.path.join(CONFIG_DIR, "operator"), "w", encoding="utf-8") as f:
                f.write(self._operator + "\n")
            with open(os.path.join(CONFIG_DIR, "screensaver_mode"), "w", encoding="utf-8") as f:
                f.write("unified\n")
        except OSError:
            pass

    def _apply_appearance(self):
        try:
            subprocess.Popen([resolve_command_path("synapse-theme"), self._variant], start_new_session=True)
        except OSError:
            pass

        try:
            with open(os.path.join(CONFIG_DIR, "icon_theme"), "w", encoding="utf-8") as f:
                f.write(self._icon_theme + "\n")
        except OSError:
            pass
        for gtk_file in ("~/.config/gtk-3.0/settings.ini", "~/.config/gtk-4.0/settings.ini"):
            try:
                update_gtk_settings(os.path.expanduser(gtk_file), self._icon_theme)
            except OSError:
                pass
        for cmd in (["xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName", "-s", self._icon_theme],
                    ["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", self._icon_theme]):
            if shutil.which(cmd[0]):
                try:
                    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except OSError:
                    pass

    def _apply_ai(self):
        key_file = os.path.join(CONFIG_DIR, "anthropic_key")
        try:
            if self._ai_engine == "claude" and self._claude_key:
                write_private(key_file, self._claude_key + "\n")
            elif os.path.exists(key_file):
                os.remove(key_file)
        except OSError:
            pass

        if self._ai_engine == "local" and self._download_models and not self._is_live:
            try:
                with open(AI_MODELS_FILE, "w", encoding="utf-8") as f:
                    f.write("\n".join(MODEL_TIERS[self._model_tier]["models"]) + "\n")
                # Runs in the background with desktop notifications; resumes on next login if interrupted
                subprocess.Popen([resolve_command_path("synapse-setup"), "--first-boot"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
            except OSError:
                pass
        elif os.path.exists(AI_MODELS_FILE):
            try:
                os.remove(AI_MODELS_FILE)
            except OSError:
                pass

    def _mark_complete(self, state):
        # Live sessions run from RAM and the live user is deleted on install, so the flag
        # never blocks the installed system's own first run unless Calamares migrates it.
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            with open(ONBOARDING_FLAG, "w", encoding="utf-8") as f:
                f.write(state + "\n")
        except OSError:
            pass


def main():
    oobe = "--oobe" in sys.argv
    if "--autostart" in sys.argv and os.path.exists(ONBOARDING_FLAG):
        sys.exit(0)

    app = QGuiApplication(sys.argv)
    app.setDesktopFileName("synapse-welcome")
    engine = QQmlApplicationEngine()

    backend = WelcomeBackend(app, oobe=oobe)
    engine.rootContext().setContextProperty("backend", backend)

    script_dir = Path(__file__).resolve().parent
    qml_file = script_dir / "Welcome.qml"
    if not qml_file.exists():
        qml_file = Path("/usr/share/synapse-hud/Welcome.qml")

    engine.load(QUrl.fromLocalFile(str(qml_file)))

    if not engine.rootObjects():
        sys.exit(1)

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
