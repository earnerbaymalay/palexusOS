def find_chrome_emblem():
    """Find the authentic 3D liquid chrome master plate emblem."""
    script_dir = Path(__file__).resolve().parent
    candidates = [
        script_dir / "master_plate_960.png",
        script_dir / "../synapse-plymouth/master_plate_960.png",
        script_dir / "../../desktop/synapse-plymouth/master_plate_960.png",
        Path("/usr/share/synapse-hud/master_plate_960.png"),
        Path("/usr/share/synapseos/branding/master_plate_960.png"),
        Path("/usr/share/plymouth/themes/synapseos-mauve/master_plate_960.png"),
        Path("/usr/share/plymouth/themes/synapseos/master_plate_960.png"),
        Path.home() / "synapseOS/packages/desktop/synapse-plymouth/master_plate_960.png",
    ]
    for c in candidates:
        p = Path(c).resolve()
        if p.is_file() and p.stat().st_size > 0:
            return str(p)
    return None


def resolve_command_path(cmd_name: str) -> str:
    """Find command either in system PATH or in repository directories."""
    found = shutil.which(cmd_name)
    if found:
        return found
    script_dir = Path(__file__).resolve().parent
    local_candidates = [
        script_dir / cmd_name,
        script_dir.parent / "synapse-themes" / cmd_name,
        script_dir.parent / "synapse-hud" / cmd_name,
        script_dir.parent / "synapse-greeter" / cmd_name,
        script_dir.parent / "synapse-core" / cmd_name,
    ]
    for c in local_candidates:
        if c.is_file():
            return str(c)
    return cmd_name


def update_gtk_settings(settings_path: str, icon_theme: str):
    """Write or update gtk-icon-theme-name under [Settings] in GTK settings.ini."""
    os.makedirs(os.path.dirname(settings_path), exist_ok=True)
    lines = []
    if os.path.exists(settings_path):
        try:
            with open(settings_path, "r", encoding="utf-8") as f:
                lines = f.readlines()
        except Exception:
            lines = []

    settings_section_idx = -1
    icon_theme_idx = -1
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped == "[Settings]":
            settings_section_idx = i
        elif stripped.startswith("gtk-icon-theme-name") and settings_section_idx != -1:
            icon_theme_idx = i
            break
        elif stripped.startswith("[") and settings_section_idx != -1 and i > settings_section_idx:
            break

    entry = f"gtk-icon-theme-name = {icon_theme}\n"
    if icon_theme_idx != -1:
        lines[icon_theme_idx] = entry
    elif settings_section_idx != -1:
        lines.insert(settings_section_idx + 1, entry)
    else:
        if lines and not lines[-1].endswith("\n"):
            lines.append("\n")
        lines.append("[Settings]\n")
        lines.append(entry)

    with open(settings_path, "w", encoding="utf-8") as f:
        f.writelines(lines)


