    # Slots
    @pyqtSlot(str)
    def toggleCombo(self, key):
        if key in self._combos:
            self._combos[key] = not self._combos[key]
            self.stateChanged.emit()

    @pyqtSlot(str, str, str)
    def testClaudeQuery(self, prompt, api_key, model):
        """Execute a live test query to Claude API or Local AI model."""
        prompt = prompt.strip() or "Verify cyberdeck defense status and telemetry readiness."
        api_key = api_key.strip()
        model = model.strip() or "claude-3-7-sonnet-20250219"

        if api_key.startswith("sk-ant"):
            try:
                # Live query to Anthropic Messages API
                url = "https://api.anthropic.com/v1/messages"
                headers = {
                    "x-api-key": api_key,
                    "anthropic-version": "2023-06-01",
                    "content-type": "application/json"
                }
                payload = {
                    "model": model,
                    "max_tokens": 128,
                    "messages": [{"role": "user", "content": prompt}]
                }
                req = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"), headers=headers, method="POST")
                with urllib.request.urlopen(req, timeout=8) as resp:
                    data = json.loads(resp.read().decode("utf-8"))
                    text = data.get("content", [{}])[0].get("text", "Handshake succeeded.")
                    self._claude_response = f"[Claude 3.7 Online]: {text.strip()}"
                    self.claudeResponseChanged.emit()
                    return
            except Exception as e:
                self._claude_response = f"[Anthropic Link Error]: {str(e)} (Key saved for session)"
                self.claudeResponseChanged.emit()
                return

        # Fallback to local Ollama or high-signal cyberdeck simulation
        try:
            req = urllib.request.Request("http://127.0.0.1:11434/api/tags")
            with urllib.request.urlopen(req, timeout=1.5) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                models = [m.get("name") for m in data.get("models", [])]
                self._claude_response = f"[Local Ollama Active]: Model weights detected: {', '.join(models) or 'Ready'}. Local copilot primed on :11434."
                self.claudeResponseChanged.emit()
                return
        except Exception:
            pass

        # Standby Verification
        self._claude_response = f"[Neural Gate Handshake OK]: Directive logged for operator '{self._operator}'. Model: {model}. Prime Directive stealth active."
        self.claudeResponseChanged.emit()

    @pyqtSlot(str)
    def launchCmd(self, cmd_str):
        try:
            parts = cmd_str.split()
            if parts:
                exe = resolve_command_path(parts[0])
                full_cmd = [exe] + parts[1:]
                subprocess.Popen(full_cmd, start_new_session=True)
            else:
                subprocess.Popen(["bash", "-c", cmd_str], start_new_session=True)
        except Exception:
            try:
                subprocess.Popen(["bash", "-c", cmd_str], start_new_session=True)
            except Exception:
                pass

    @pyqtSlot()
    def applyAndFinish(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)

        # 1. Save Full Operator Profile, Claude config, and Feature Combos
        try:
            profile = {
                "operator": self._operator,
                "hostname": self._hostname,
                "ai_engine": self._ai_engine,
                "claude_model": self._claude_model,
                "has_claude_key": bool(self._claude_key),
                "feature_combos": self._combos,
                "icon_theme": self._selected_icon_theme,
                "wallpaper_variant": self._selected_wallpaper,
                "screensaver_mode": "unified"
            }
            with open(os.path.join(CONFIG_DIR, "operator_profile.json"), "w", encoding="utf-8") as f:
                json.dump(profile, f, indent=2)
            with open(os.path.join(CONFIG_DIR, "operator"), "w", encoding="utf-8") as f:
                f.write(self._operator + "\n")

            if self._claude_key:
                with open(os.path.join(CONFIG_DIR, "anthropic_key"), "w", encoding="utf-8") as f:
                    f.write(self._claude_key + "\n")
        except Exception:
            pass

        # 2. Apply Metallic Icon Theme (GTK / XFCE / GNOME)
        try:
            subprocess.run([
                "xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName", "-s", self._selected_icon_theme
            ], check=False)
            with open(os.path.join(CONFIG_DIR, "icon_theme"), "w") as f:
                f.write(self._selected_icon_theme + "\n")

            gtk3_file = os.path.expanduser("~/.config/gtk-3.0/settings.ini")
            gtk4_file = os.path.expanduser("~/.config/gtk-4.0/settings.ini")
            for gtk_file in (gtk3_file, gtk4_file):
                try:
                    update_gtk_settings(gtk_file, self._selected_icon_theme)
                except Exception:
                    pass

            if shutil.which("gsettings"):
                subprocess.run([
                    "gsettings", "set", "org.gnome.desktop.interface", "icon-theme", self._selected_icon_theme
                ], check=False)
        except Exception:
            pass

        # 3. Apply Wallpaper & Accent
        try:
            subprocess.run(["synapse-theme", self._selected_wallpaper], check=False)
        except Exception:
            pass

        # 4. Save Screensaver Preference
        try:
            with open(os.path.join(CONFIG_DIR, "screensaver_mode"), "w") as f:
                f.write("unified\n")
        except Exception:
            pass

        # 5. Mark Onboarding Complete
        try:
            with open(ONBOARDING_FLAG, "w") as f:
                f.write("completed\n")
        except Exception:
            pass

        # 6. Launch Command HUD Cockpit
        try:
            hud_exe = resolve_command_path("synapse-hud")
            subprocess.Popen([hud_exe], start_new_session=True)
        except Exception:
            pass

        self.app.quit()


def main():
    if "--autostart" in sys.argv:
        if os.path.exists(ONBOARDING_FLAG):
            sys.exit(0)

    app = QGuiApplication(sys.argv)
    app.setDesktopFileName("synapse-welcome")
    engine = QQmlApplicationEngine()

    backend = WelcomeBackend(app)
    engine.rootContext().setContextProperty("backend", backend)

    script_dir = Path(__file__).resolve().parent
    qml_file = script_dir / "Welcome.qml"
    if not qml_file.exists():
        qml_file = Path("/usr/share/synapse-hud/Welcome.qml")

    engine.load(QUrl.fromLocalFile(str(qml_file)))

    if not engine.rootObjects():
        sys.exit(1)

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
