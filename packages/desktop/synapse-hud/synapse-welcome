        self.app = app
        self._chrome_path = find_chrome_emblem()
        self._chrome_logo_path = find_chrome_logo()
        self._chrome_spin_path = find_chrome_spin()
        self._chrome_plate_path = find_chrome_plate()
        self._operator = os.environ.get("USER", "operator")
        try:
            self._hostname = socket.gethostname() or "synapse-deck"
        except Exception:
            self._hostname = "synapse-deck"

        self._ai_engine = "claude"
        self._claude_key = ""
        self._claude_model = "claude-3-7-sonnet-20250219"
        self._claude_response = "Ready. Enter prompt above and click 'Query Claude' to test live communication."

        self._combos = {
            "stealth": True,
            "dot": True,
            "firewall": True,
            "mem_scrub": True,
            "ollama": True,
            "vector_mem": True,
            "gpu_tensor": True,
            "bore": True,
            "zram": True,
            "audio_rt": True,
            "wayland": True,
            "hotkey_hud": True
        }
        self._selected_icon_theme = "Synapse-Liquid-Chrome"
        self._selected_wallpaper = "monolith-mauve"
        self._selected_screensaver = "unified"

    # Properties exposed to QML
