{
  "version": "1.0.0",
  "name": "PalexusOS Design Tokens",
  "description": "Complete design system tokens for PalexusOS (Obsidian Dark theme)",
  "colors": {
    "primary": {
      "mauve": "#cba6f7",
      "gold": "#fab387",
      "crimson": "#f38ba8",
      "sapphire": "#74c7ec",
      "emerald": "#a6e3a1",
      "chrome": "#cdd6f4",
      "obsidian": "#11111b"
    },
    "surface": {
      "900": "#11111b",
      "800": "#1e1e2e",
      "700": "#2a2a3e",
      "600": "#313244",
      "500": "#45454f"
    },
    "text": {
      "primary": "#cdd6f4",
      "secondary": "#a6adc8",
      "tertiary": "#7f849c"
    },
    "functional": {
      "success": "#a6e3a1",
      "warning": "#fab387",
      "error": "#f38ba8",
      "info": "#74c7ec"
    }
  },
  "typography": {
    "families": {
      "mono": "JetBrains Mono Nerd Font, Courier New, monospace",
      "system": "system-ui, -apple-system, Segoe UI, sans-serif"
    },
    "scales": {
      "h1": {
        "size": "32px",
        "weight": 700,
        "lineHeight": 1.2,
        "letterSpacing": "-0.02em"
      },
      "h2": {
        "size": "24px",
        "weight": 700,
        "lineHeight": 1.3,
        "letterSpacing": "-0.01em"
      },
      "h3": {
        "size": "18px",
        "weight": 700,
        "lineHeight": 1.4
      },
      "body-lg": {
        "size": "16px",
        "weight": 400,
        "lineHeight": 1.6
      },
      "body": {
        "size": "14px",
        "weight": 400,
        "lineHeight": 1.5
      },
      "body-sm": {
        "size": "12px",
        "weight": 400,
        "lineHeight": 1.5
      },
      "terminal": {
        "size": "14px",
        "weight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "0.01em"
      },
      "code": {
        "size": "13px",
        "weight": 400,
        "lineHeight": 1.5
      }
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "8": "48px"
  },
  "radius": {
    "sm": "2px",
    "md": "4px",
    "lg": "8px",
    "xl": "16px"
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.5)",
    "lg": "0 12px 32px rgba(0, 0, 0, 0.6)",
    "glow-mauve": "0 0 16px rgba(203, 166, 247, 0.3)"
  },
  "breakpoints": {
    "sm": "768px",
    "md": "1024px",
    "lg": "1440px",
    "xl": "1920px"
  },
  "z-index": {
    "base": 0,
    "raised": 1,
    "floating": 2,
    "modal": 3,
    "overlay": 4,
    "top": 5
  },
  "transitions": {
    "quick": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "standard": {
      "duration": "300ms",
      "easing": "cubic-bezier(0.25, 0.46, 0.45, 0.94)"
    },
    "slow": {
      "duration": "500ms",
      "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)"
    }
  }
}
