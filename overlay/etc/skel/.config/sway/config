# ==============================================================================
# ~/.config/sway/config — PalexusOS Dual-Session Wayland Tiling Configuration
# Aesthetic: Catppuccin Mocha Mauve (#cba6f7), Liquid Silver Chrome (#cdd6f4),
#            Obsidian Crust (#11111b), Base (#1e1e2e)
# ==============================================================================

# --- Core Variables ---
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term kitty
set $term_alt foot
set $menu /usr/bin/palexus-hud

# --- Palette Tokens (Catppuccin Mocha + Liquid Chrome + Obsidian Crust) ---
set $crust    #11111b
set $base     #1e1e2e
set $mauve    #cba6f7
set $silver   #cdd6f4

# --- Typography & Window Geometry ---
font pango:JetBrainsMono Nerd Font Mono 10
default_border normal 2
default_floating_border normal 2
titlebar_border_thickness 1
titlebar_padding 4 8
gaps inner 8
gaps outer 4
smart_borders on

# --- Output & Idle Management ---
output * bg #11111b solid_color
output * bg /usr/share/backgrounds/palexusos/palexus-monolith-mauve.jpg fill #11111b
# Sway owns the background (output bg); palexus-theme --restore re-applies the saved theme
exec palexus-theme --restore

# Screensaver is not a lock: 5 min -> geodesic torus, 10 min -> displays off
exec swayidle -w \
    timeout 300 'palexus-screensaver --launch' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"'

# --- Client Window Border Colors (AMOLED Black Top Bar) ---
# class                 border   backgr.  text     indicator child_border
client.focused          #11111b  #050508  #cdd6f4  #cba6f7   #313244
client.focused_inactive #11111b  #000000  #a6adc8  #11111b   #11111b
client.unfocused        #11111b  #000000  #6c7086  #11111b   #11111b
client.urgent           #f38ba8  #050508  #f38ba8  #f38ba8   #f38ba8
client.placeholder      #050508  #050508  #cdd6f4  #050508   #050508
client.background       #050508

# --- Mnemonic Application Launchers (Super + First Letter) ---
bindsym Mod4+s exec /usr/bin/palexus-hud
bindsym Mod4+space exec /usr/bin/palexus-hud
bindsym Mod4+d exec /usr/bin/palexus-hud
# Secondary prompt palette: /usr/bin/quickfire
bindsym Mod4+t exec kitty
bindsym Mod4+Return exec kitty
bindsym Mod4+Shift+Return exec foot
bindsym Mod4+b exec chromium
bindsym Mod4+f exec thunar
bindsym Mod4+n exec /usr/bin/palexus-notes
bindsym Mod4+c exec /usr/bin/galculator
bindsym Mod4+i exec [ -d /run/archiso ] && sudo -E /usr/bin/calamares
bindsym Mod4+a exec /usr/bin/audio-switch
bindsym Mod4+Shift+o exec /usr/bin/palexus-welcome
bindsym Mod4+slash exec /usr/bin/palexus-shortcuts
bindsym Mod4+question exec /usr/bin/palexus-shortcuts
bindsym Mod4+m exec palexus-theme --menu
bindsym Mod4+Ctrl+t exec palexus-theme --menu
bindsym Mod4+p exec /usr/bin/sec-status

# --- Window Closing & Session Management (Esc, Mouse & Keys) ---
bindsym Mod4+w kill
bindsym Mod4+q kill
bindsym Mod4+Escape kill
bindsym Mod4+Shift+q kill
bindsym Mod4+Shift+w kill
bindsym Mod4+c kill
bindsym Mod4+BackSpace kill
bindsym Alt+F4 kill
bindsym Mod1+F4 kill
bindsym Mod1+q kill
bindsym Mod1+w kill
bindsym Mod4+Shift+c reload
bindsym Mod4+Shift+e exec swaymsg exit

# Mouse Window Actions:
# Super+Left-drag moves, Super+Right-drag resizes, Super+Middle-click closes window
floating_modifier Mod4 normal
bindsym --whole-window Mod4+button2 kill
bindsym --border Mod4+button2 kill
bindsym --border Mod4+button3 kill
bindsym --border button2 kill
bindsym --border button3 kill

# --- Direct Window Adjustment Shortcuts (No Modal Mode Required) ---
bindsym Mod4+Ctrl+Left resize shrink width 40px
bindsym Mod4+Ctrl+Right resize grow width 40px
bindsym Mod4+Ctrl+Up resize grow height 40px
bindsym Mod4+Ctrl+Down resize shrink height 40px
bindsym Mod4+bracketleft resize shrink width 40px
bindsym Mod4+bracketright resize grow width 40px

# --- Keybindings: Wayland Screenshots & Clipboard (grim + slurp + wl-clipboard) ---
bindsym Print exec grim -g "$(slurp)" - | wl-copy
bindsym Shift+Print exec grim - | wl-copy

# --- Keybindings: Focus Navigation ---
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# --- Keybindings: Move Containers ---
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- Keybindings: Workspaces (1 - 10) ---
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# --- Keybindings: Layout & Scratchpad ---
bindsym $mod+backslash splith
bindsym $mod+v splitv
bindsym $mod+Shift+s layout stacking
bindsym $mod+Shift+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+f fullscreen
bindsym F11 fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+a focus parent
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# --- Resize Mode ---
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# --- Comprehensive Floating Window Rules ---
for_window [app_id="palexus-screensaver"] fullscreen enable
for_window [app_id="(?i)palexus-hud"] floating enable, border pixel 0
for_window [class="(?i)palexus-hud"] floating enable, border pixel 0
for_window [app_id="(?i)palexus-welcome"] floating enable, move position center
for_window [class="(?i)palexus-welcome"] floating enable, move position center
for_window [app_id="(?i)palexus-settings"] floating enable, move position center
for_window [class="(?i)palexus-settings"] floating enable, move position center
for_window [app_id="(?i)palexus-notes"] floating enable, move position center
for_window [class="(?i)palexus-notes"] floating enable, move position center
for_window [app_id="palexus-shortcuts"] floating enable, resize set 860 620, move position center
for_window [title=".*Keybindings Cheat Sheet.*"] floating enable, resize set 860 620, move position center
for_window [app_id="(?i)quickfire"] floating enable, border pixel 2
for_window [class="(?i)quickfire"] floating enable, border pixel 2
for_window [app_id="(?i)calamares"] floating enable, move position center
for_window [class="(?i)calamares"] floating enable, move position center
for_window [app_id="(?i)galculator"] floating enable, move position center
for_window [class="(?i)galculator"] floating enable, move position center
for_window [app_id="(?i)pavucontrol"] floating enable, move position center
for_window [class="(?i)pavucontrol"] floating enable, move position center
for_window [app_id="(?i)audio-switch"] floating enable, move position center
for_window [class="(?i)audio-switch"] floating enable, move position center
for_window [title="(?i)Audio Output Switcher"] floating enable, move position center
for_window [app_id="(?i)sec-status"] floating enable, resize set 800 550, move position center
for_window [title=".*Security & Anonymity Audit.*"] floating enable, resize set 800 550, move position center
for_window [app_id="(?i)nm-connection-editor"] floating enable, move position center
for_window [class="(?i)nm-connection-editor"] floating enable, move position center
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable

# --- Waybar Status Bar ---
bar {
    swaybar_command waybar
}

# --- Autostart Services & Onboarding ---

# First-run setup: --autostart exits at once when ~/.config/palexus/.onboarding_complete exists
exec /usr/bin/palexus-welcome --autostart
# Resumes a local-model download the user agreed to in setup; no-op otherwise
exec /usr/bin/palexus-setup --first-boot

include /etc/sway/config.d/*
