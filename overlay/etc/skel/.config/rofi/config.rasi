/**
 * PalexusOS Sovereign Luxury Application Launcher
 * Cyber-organic deep obsidian & purple luminescent theme
 **/

configuration {
    modi: "drun,run,filebrowser,window";
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: " Applications";
    display-run: " Command";
    display-filebrowser: " Files";
    display-window: " Windows";
    drun-display-format: "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
}

@theme "/dev/null"

* {
    bg-col:  #0b0a10;
    bg-col-light: #161424;
    border-col: #7c3aed;
    selected-col: #221d3b;
    purple: #a855f7;
    fg-col: #f3f0ff;
    fg-col-dim: #9490a8;
    width: 680;
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 480px;
    border: 2px;
    border-radius: 12px;
    border-color: @border-col;
    background-color: @bg-col;
}

mainbox {
    background-color: @bg-col;
    padding: 16px;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 6px 12px;
    margin: 0px 0px 14px 0px;
    border: 1px;
    border-color: #3b2d54;
}

prompt {
    background-color: @purple;
    padding: 4px 10px;
    text-color: #0b0a10;
    border-radius: 6px;
    margin: 2px 8px 2px 0px;
    font: "JetBrainsMono Nerd Font Bold 11";
}

entry {
    padding: 6px;
    margin: 0px 0px 0px 4px;
    text-color: @fg-col;
    background-color: transparent;
}

listview {
    border: 0px;
    padding: 4px 0px;
    margin: 4px 0px 0px 0px;
    columns: 1;
    lines: 7;
    background-color: transparent;
}

element {
    padding: 10px 14px;
    background-color: transparent;
    text-color: @fg-col-dim;
    border-radius: 8px;
    margin: 2px 0px;
}

element-icon {
    size: 26px;
    margin: 0px 12px 0px 0px;
}

element selected {
    background-color: @selected-col;
    text-color: @purple;
    border: 1px;
    border-color: @purple;
}

mode-switcher {
    spacing: 12px;
    margin: 14px 0px 0px 0px;
}

button {
    padding: 8px 14px;
    background-color: @bg-col-light;
    text-color: @fg-col-dim;
    border-radius: 6px;
}

button selected {
    background-color: @purple;
    text-color: #0b0a10;
    font: "JetBrainsMono Nerd Font Bold 11";
}
